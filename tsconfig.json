{
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noPropertyAccessFromIndexSignature": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"types": ["@types/bun"],
		"paths": {
			"@mcp-vertex/core/public": ["/home/cartago/_projects/mcp-vertex/packages/core/src/public/index.ts"],
			"@mcp-vertex/core": ["/home/cartago/_projects/mcp-vertex/packages/core/src/index.ts"]
		}
	},
	"include": ["src/**/*", "plugins/**/*", "scripts/**/*"],
	"exclude": ["node_modules", "dist", "build", ".cache"]
}