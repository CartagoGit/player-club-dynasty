      "operations": 50000,
      "fixture": "one deterministic aggregate career advance per operation",
      "maxMedianMilliseconds": 100
    },
    {
      "id": "macro-season-advance",
      "operations": 1,
      "fixture": "512 clubs across 16 competitions",
      "maxMedianMilliseconds": 50,
      "benchmark": "PCDynasty.Benchmarks.MacroWorldBenchmarks.AdvanceMacroSeason"
    },
    {
      "id": "materialization",
      "operations": 1,
      "fixture": "one club promoted from a 512-club checkpoint",
