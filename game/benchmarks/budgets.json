    },
    {
      "id": "world-club-lookup",
      "operations": 1,
      "fixture": "one club resolved by identifier from an indexed 6,400-club world",
      "maxMedianMilliseconds": 16,
      "benchmark": "PCDynasty.Benchmarks.WorldLoadBenchmarks.FindClubById"
