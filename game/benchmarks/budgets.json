      "benchmark": "PCDynasty.Benchmarks.MaterializationBenchmarks.MaterializeClub"
    },
    {
      "id": "persistence-load",
      "operations": 1,
      "fixture": "1 MiB snapshot plus 256 facts from an external SQLite save",
