[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://Scripts/Matches/LineupSelectionController.cs" id="1_controller"]
[ext_resource type="Theme" path="res://Theme/PCDynastyTheme.tres" id="2_theme"]

[node name="LineupSelection" type="Control"]
layout_mode = 3
anchors_preset = 15
