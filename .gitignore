# delendai scratch + caches
.cache/
.delendai-root
.verify-tmp/

# bun / node
node_modules/
dist/
build/
coverage/

# .NET build, test and benchmark outputs
**/[Bb]in/
**/[Oo]bj/
**/TestResults/
**/BenchmarkDotNet.Artifacts/
*.user
*.suo
*.rsuser
*.userosscache
*.sln.docstates

# Godot-generated editor/import state
**/.godot/
**/.import/
**/.mono/
*.translation
export_credentials.cfg
*.pck
*.apk
*.aab

# Godot resource UIDs are authored source metadata and stay versioned.
!game/godot/**/*.uid

# editor / OS
.vscode/.cache/
.vs/
.idea/
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*
bun-debug.log*

# env / secrets — never commit these
.env
.env.*
!.env.example

# local data — clubs.json etc. generated by the player-club plugin
data/
saves/
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# authored, distributable game content is source, not local generated data
!game/content/**

# AI-tool caches that re-create themselves on demand
.claude/settings.local.json
.continue/dev_data/
.aider.chat.history.sqlite
.aider.input.history
.aider.tags.cache.v3/

# provisioned toolchains (Godot editor downloads)
.tools/

# PC Dynasty — generated asset workflow
#   .generate/        : everything that the tooling creates locally
#                          during audio / content / world generation
#       audios/staging/ : review queue of generated mp3/ogg (was .audio-staging/)
#       prompts/audios/  : the declarative prompt library for audio generation
#                          (77 files: shared sonic identity + per-group
#                          identity + per-entry brief)
#       ...             : other generated content (worlds, textures, etc.)
#   .deprecated/      : superseded approved assets, kept locally but never shipped
.generate/
.deprecated/
