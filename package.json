{
	"name": "player-club-dynasty",
	"version": "0.1.0",
	"private": true,
	"description": "Player Club Dynasty — a football manager game scaffolded with mcp-vertex for AI-assisted development.",
	"type": "module",
	"license": "BSD-3-Clause",
	"author": "Cartago",
	"engines": {
		"bun": ">=1.1.0"
	},
	"scripts": {
		"mcp-vertex:serve": "bun scripts/dev.script.ts",
		"mcp-vertex:doctor": "bun run build:plugin && bun scripts/dev.script.ts --doctor",
		"mcp-vertex:cli": "bun scripts/mcp-vertex-run.script.ts packages/cli/src/index.ts",
		"mcp-vertex:overview": "bun scripts/mcp-vertex-run.script.ts packages/cli/src/index.ts --workspace=. --config=./mcp-vertex.config.json --preset=swarm --exclude-plugins=issues,web-fetch,external-mcps overview --json",
		"mcp-vertex:catalog": "bun scripts/mcp-vertex-run.script.ts packages/cli/src/index.ts --workspace=. --config=./mcp-vertex.config.json --preset=swarm --exclude-plugins=issues,web-fetch,external-mcps catalog --compact",
		"mcp-vertex:types": "bun scripts/mcp-vertex-run.script.ts tools/scripts/types/generate-tool-types.script.ts",
		"mcp-vertex:validate": "bun scripts/mcp-vertex-run.script.ts tools/scripts/lint/file-conventions.script.ts && bun scripts/mcp-vertex-run.script.ts tools/scripts/lint/proposals.script.ts",
		"lint:proposals": "bun scripts/lint-proposals.script.ts",
		"check:visible-routes": "bun scripts/check-visible-capability-routes.script.ts",
		"mcp-vertex:verify-tools": "bun scripts/mcp-vertex-run.script.ts tools/scripts/verify/plugin-tool-verify.script.ts --plugin=mcp-vertex_player-club-dynasty --workspace=.",
		"mcp-vertex:hints": "bun scripts/mcp-vertex-run.script.ts tools/scripts/catalog/render-host-hints.script.ts",
		"mcp-vertex:sync-bootstrap": "bun scripts/sync-bootstrap.script.ts",
		"mcp-vertex:resolve-root": "bun scripts/mcp-vertex-root.script.ts",
		"plugin:create": "bun scripts/mcp-vertex-run.script.ts tools/scripts/create-plugin.ts",
		"validate": "bun run mcp-vertex:validate && bun run lint:proposals && bun run check:visible-routes && bun run typecheck && bun run test && bun run test:scripts",
		"dev": "bun scripts/dev.script.ts",
		"build": "bun scripts/build.script.ts",
		"build:plugin": "bun scripts/build-plugin.script.ts mcp-vertex_player-club-dynasty",
		"typecheck": "bunx tsc --noEmit -p tsconfig.json && bun run --cwd plugins/mcp-vertex_player-club-dynasty typecheck",
		"test": "bun run --cwd plugins/mcp-vertex_player-club-dynasty test",
		"test:scripts": "bunx vitest run",
		"game:play": "bun scripts/play-game.script.ts",
		"game:editor": "bun scripts/play-game.script.ts --editor",
		"game:import": "bun scripts/play-game.script.ts --headless --import",
		"game:smoke": "bun scripts/run-godot-smoke.script.ts",
		"game:smoke:provision": "bun scripts/run-godot-smoke.script.ts --provision",
		"game:doctor": "bun scripts/game-doctor.script.ts",
		"game:resolve": "bun scripts/game-doctor.script.ts --resolve",
		"game:tests": "bash ./game/scripts/test-all.sh",
		"game:architecture": "bash ./game/scripts/check-architecture.sh",
		"game:hygiene": "bash ./game/scripts/check-repository-hygiene.sh",
		"game:benchmarks": "bash ./game/scripts/run-benchmarks.sh",
		"postinstall": "bun scripts/link-mcp-vertex.script.ts"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	}
}
