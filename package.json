{
	"name": "player-club-dynasty",
	"version": "0.1.0",
	"private": true,
	"description": "Player Club Dynasty — a football manager game scaffolded with mcp-vertex for AI-assisted development.",
	"type": "module",
	"license": "BSD-3-Clause",
	"author": "Cartago",
	"engines": {
		"bun": ">=1.1.0"
	},
	"scripts": {
		"mcp-vertex:serve": "bun tools/scripts/workspace/dev.script.ts",
		"mcp-vertex:doctor": "bun run build:plugin && bun tools/scripts/workspace/dev.script.ts --doctor",
		"mcp-vertex:cli": "bun tools/scripts/workspace/run.script.ts packages/cli/src/index.ts",
		"mcp-vertex:overview": "bun tools/scripts/workspace/run.script.ts packages/cli/src/index.ts --workspace=. --config=./mcp-vertex.config.json --preset=swarm --exclude-plugins=issues,web-fetch,external-mcps overview --json",
		"mcp-vertex:catalog": "bun tools/scripts/workspace/run.script.ts packages/cli/src/index.ts --workspace=. --config=./mcp-vertex.config.json --preset=swarm --exclude-plugins=issues,web-fetch,external-mcps catalog --compact",
		"mcp-vertex:types": "bun tools/scripts/workspace/run.script.ts tools/scripts/types/generate-tool-types.script.ts",
		"mcp-vertex:validate": "bun tools/scripts/workspace/run.script.ts tools/scripts/lint/file-conventions.script.ts && bun tools/scripts/workspace/run.script.ts tools/scripts/lint/proposals.script.ts",
		"lint:proposals": "bun tools/scripts/workspace/lint-proposals.script.ts",
		"check:visible-routes": "bun tools/scripts/replays/visible-routes.script.ts",
		"mcp-vertex:verify-tools": "bun tools/scripts/workspace/run.script.ts tools/scripts/verify/plugin-tool-verify.script.ts --plugin=mcp-vertex_player-club-dynasty --workspace=.",
		"mcp-vertex:hints": "bun tools/scripts/workspace/run.script.ts tools/scripts/catalog/render-host-hints.script.ts",
		"mcp-vertex:sync-bootstrap": "bun tools/scripts/workspace/sync-bootstrap.script.ts",
		"mcp-vertex:resolve-root": "bun tools/scripts/workspace/root.script.ts",
		"plugin:create": "bun tools/scripts/workspace/run.script.ts tools/scripts/create-plugin.ts",
		"validate": "bun run mcp-vertex:validate && bun run lint:proposals && bun run check:visible-routes && bun run typecheck && bun run test && bun run test:scripts",
		"dev": "bun tools/scripts/workspace/dev.script.ts",
		"build": "bun tools/scripts/build/all.script.ts",
		"build:plugin": "bun tools/scripts/build/plugin.script.ts mcp-vertex_player-club-dynasty",
		"typecheck": "bunx tsc --noEmit -p tsconfig.json && bun run --cwd plugins/mcp-vertex_player-club-dynasty typecheck",
		"test": "bun run --cwd plugins/mcp-vertex_player-club-dynasty test",
		"test:scripts": "bunx vitest run",
		"game:play": "bun tools/scripts/game/play.script.ts",
		"game:editor": "bun tools/scripts/game/play.script.ts --editor",
		"game:import": "bun tools/scripts/game/play.script.ts --headless --import",
		"game:smoke": "bun tools/scripts/game/run-godot-smoke.script.ts",
		"game:smoke:provision": "bun tools/scripts/game/run-godot-smoke.script.ts --provision",
		"game:doctor": "bun tools/scripts/game/doctor.script.ts",
		"game:resolve": "bun tools/scripts/game/doctor.script.ts --resolve",
		"game:tests": "bun tools/scripts/gate/tests.script.ts",
		"game:architecture": "bun tools/scripts/gate/architecture.script.ts",
		"game:hygiene": "bun tools/scripts/gate/hygiene.script.ts",
		"game:benchmarks": "bun tools/scripts/gate/benchmarks.script.ts",
		"postinstall": "bun tools/scripts/workspace/link.script.ts"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	}
}
