{
	"name": "player-club-dynasty",
	"version": "0.1.0",
	"private": true,
	"description": "Player Club Dynasty — a football manager game scaffolded with delendai for AI-assisted development.",
	"type": "module",
	"license": "BSD-3-Clause",
	"author": "Cartago",
	"engines": {
		"bun": ">=1.1.0"
	},
	"scripts": {
		"delendai:serve": "bun tools/scripts/workspace/dev.script.ts",
		"delendai:doctor": "bun run build:plugin && bun tools/scripts/workspace/dev.script.ts --doctor",
		"delendai:cli": "bun tools/scripts/workspace/run.script.ts packages/cli/src/index.ts",
		"delendai:overview": "bun tools/scripts/workspace/run.script.ts packages/cli/src/index.ts --workspace=. --config=./delendai.config.json --preset=swarm --exclude-plugins=issues,web-fetch,external-mcps overview --json",
		"delendai:catalog": "bun tools/scripts/workspace/run.script.ts packages/cli/src/index.ts --workspace=. --config=./delendai.config.json --preset=swarm --exclude-plugins=issues,web-fetch,external-mcps catalog --compact",
		"delendai:types": "bun tools/scripts/workspace/run.script.ts tools/scripts/types/generate-tool-types.script.ts",
		"delendai:validate": "bun tools/scripts/workspace/run.script.ts tools/scripts/lint/file-conventions.script.ts && bun tools/scripts/workspace/run.script.ts tools/scripts/lint/proposals.script.ts",
		"lint:proposals": "bun tools/scripts/workspace/lint-proposals.script.ts",
		"check:visible-routes": "bun tools/scripts/replays/visible-routes.script.ts",
		"delendai:verify-tools": "bun tools/scripts/workspace/run.script.ts tools/scripts/verify/plugin-tool-verify.script.ts --plugin=delendai_player-club-dynasty --workspace=.",
		"delendai:hints": "bun tools/scripts/workspace/run.script.ts tools/scripts/catalog/render-host-hints.script.ts",
		"delendai:sync-bootstrap": "bun tools/scripts/workspace/sync-bootstrap.script.ts",
		"delendai:resolve-root": "bun tools/scripts/workspace/root.script.ts",
		"plugin:create": "bun tools/scripts/workspace/run.script.ts tools/scripts/create-plugin.ts",
		"validate": "bun run delendai:validate && bun run lint:proposals && bun run check:visible-routes && bun run typecheck && bun run test && bun run test:scripts",
		"dev": "bun tools/scripts/workspace/dev.script.ts",
		"build": "bun tools/scripts/builder/all.script.ts",
		"build:plugin": "bun tools/scripts/builder/plugin.script.ts delendai_player-club-dynasty",
		"typecheck": "bunx tsc --noEmit -p tsconfig.json && bun run --cwd plugins/delendai_player-club-dynasty typecheck",
		"test": "bun run --cwd plugins/delendai_player-club-dynasty test",
		"test:scripts": "bunx vitest run",
		"game:play": "bun tools/scripts/game/play.script.ts",
		"game:editor": "bun tools/scripts/game/play.script.ts --editor",
		"game:import": "bun tools/scripts/game/play.script.ts --headless --import",
		"game:smoke": "bun tools/scripts/game/run-godot-smoke.script.ts",
		"game:smoke:provision": "bun tools/scripts/game/run-godot-smoke.script.ts --provision",
		"game:doctor": "bun tools/scripts/game/doctor.script.ts",
		"download": "bun tools/scripts/reference/download.script.ts",
		"download:catalog": "bun tools/scripts/reference/download.script.ts --catalog",
		"download:all-dynamic-multimedia-games": "bun tools/scripts/reference/download.script.ts --all",
		"vm:list": "bun tools/scripts/reference/vm.script.ts list",
		"vm:status": "bun tools/scripts/reference/vm.script.ts status",
		"vm:start": "bun tools/scripts/reference/vm.script.ts start",
		"vm:stop": "bun tools/scripts/reference/vm.script.ts stop",
		"vm:poweroff": "bun tools/scripts/reference/vm.script.ts poweroff",
		"vm:screenshot": "bun tools/scripts/reference/vm.script.ts screenshot",
		"vm:move": "bun tools/scripts/reference/vm.script.ts move",
		"vm:click": "bun tools/scripts/reference/vm.script.ts click",
		"vm:drag": "bun tools/scripts/reference/vm.script.ts drag",
		"vm:key": "bun tools/scripts/reference/vm.script.ts key",
		"game:explore": "bun tools/scripts/game/explore.script.ts",
		"game:resolve": "bun tools/scripts/game/doctor.script.ts --resolve",
		"game:video:stage": "bun tools/scripts/content/video/generate.script.ts stage",
		"game:video:fetch": "bun tools/scripts/content/video/generate.script.ts fetch",
		"game:video:list": "bun tools/scripts/content/video/generate.script.ts list --all",
		"game:video:approve": "bun tools/scripts/content/video/generate.script.ts approve",
		"game:video:deprecate": "bun tools/scripts/content/video/generate.script.ts deprecate",
		"game:video:status": "bun tools/scripts/content/video/generate.script.ts status",
		"game:video:validate": "bun tools/scripts/content/video/generate.script.ts --validate",
		"game:audio:stage": "bun tools/scripts/content/audio/generate.script.ts stage",
		"game:audio:list": "bun tools/scripts/content/audio/generate.script.ts list --all",
		"game:audio:listen": "bun tools/scripts/content/audio/generate.script.ts listen",
		"game:audio:approve": "bun tools/scripts/content/audio/generate.script.ts approve",
		"game:audio:deprecate": "bun tools/scripts/content/audio/generate.script.ts deprecate",
		"game:audio:status": "bun tools/scripts/content/audio/generate.script.ts status",
		"game:audio:validate": "bun tools/scripts/content/audio/generate.script.ts --validate",
		"game:audio:checklist": "bun tools/scripts/content/audio/checklist.script.ts",
		"game:audio:review": "bun tools/scripts/content/audio/review.script.ts",
		"game:audio:review:ui": "bun tools/scripts/content/audio/serve-review.script.ts --open",
		"game:audio:open": "bun tools/scripts/content/audio/open.script.ts",
		"game:audio:precompress": "bun tools/scripts/content/audio/precompress.script.ts",
		"game:audio:rebuild-all": "bun tools/scripts/content/audio/rebuild-all.script.ts",
		"game:tests": "bun tools/scripts/gate/tests.script.ts",
		"game:architecture": "bun tools/scripts/gate/architecture.script.ts",
		"game:hygiene": "bun tools/scripts/gate/hygiene.script.ts",
		"game:benchmarks": "bun tools/scripts/gate/benchmarks.script.ts",
		"prepare": "bun tools/scripts/workspace/link.script.ts || true",
		"delendai:check-paths": "bun tools/scripts/workspace/portable-paths.script.ts --check"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	}
}
