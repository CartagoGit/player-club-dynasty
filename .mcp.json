{
	"mcpServers": {
		"delendai": {
			"type": "stdio",
			"command": "bun",
			"args": [
				"./tools/scripts/workspace/run.script.ts",
				"tools/scripts/host/host-server.script.ts",
				"--workspace=.",
				"--config=./delendai.config.json",
				"--preset=swarm",
				"--exclude-plugins=issues,web-fetch,external-mcps"
			]
		}
	}
}
