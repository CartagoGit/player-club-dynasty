{
	"mcpServers": {
		"mcp-vertex": {
			"type": "stdio",
			"command": "bun",
			"args": [
				"./scripts/mcp-vertex-run.script.ts",
				"tools/scripts/host/host-server.script.ts",
				"--workspace=.",
				"--config=./mcp-vertex.config.json",
				"--preset=swarm",
				"--exclude-plugins=issues,web-fetch,external-mcps"
			]
		}
	}
}
