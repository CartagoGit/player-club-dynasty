{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext", "DOM"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": false,
		"noEmit": true,
		"types": ["@types/bun", "vitest/globals"],
		"paths": {
			"@delendai/core/public": ["./node_modules/@delendai/core/src/public/index.ts"],
			"@delendai/core": ["./node_modules/@delendai/core/src/index.ts"]
		}
	},
	"include": ["src/**/*", "tests/**/*"],
	"exclude": ["node_modules", "dist"]
}