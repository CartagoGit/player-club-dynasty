{
	"servers": {
		"mcp-vertex": {
			"type": "stdio",
			"command": "bun",
			"args": [
				"${workspaceFolder}/scripts/mcp-vertex-run.script.ts",
				"tools/scripts/host/host-server.script.ts",
				"--workspace=${workspaceFolder}",
				"--config=${workspaceFolder}/mcp-vertex.config.json",
				"--preset=swarm",
				"--exclude-plugins=issues,web-fetch,external-mcps"
			]
		},
		"godot": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@coding-solo/godot-mcp"
			],
			"env": {
				"GODOT_PATH": "${env:GODOT_BIN}",
				"DEBUG": "false"
			},
			"autoApprove": [
				"launch_editor",
				"run_project",
				"get_debug_output",
				"stop_project",
				"get_godot_version",
				"list_projects",
				"get_project_info",
				"create_scene",
				"add_node",
				"load_sprite",
				"export_mesh_library",
				"save_scene",
				"get_uid",
				"update_project_uids"
			]
		}
	}
}