{
	"servers": {
		"delendai": {
			"type": "stdio",
			"command": "bun",
			"args": [
				"${workspaceFolder}/tools/scripts/workspace/run.script.ts",
				"tools/scripts/host/host-server.script.ts",
				"--workspace=${workspaceFolder}",
				"--config=${workspaceFolder}/delendai.config.json",
				"--preset=swarm",
				"--exclude-plugins=issues,web-fetch,external-mcps"
			]
		},
		"godot": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@coding-solo/godot-mcp"
			],
			"env": {
				"GODOT_PATH": "${workspaceFolder}/.tools/godot/current",
				"DEBUG": "false"
			}
		}
	}
}
