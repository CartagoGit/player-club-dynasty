{
	"terminal.integrated.profiles.linux": {
		"Bash (login)": {
			"path": "/bin/bash",
			"args": ["--login"]
		}
	},

	// Por defecto (para todo lo que abra terminal: Copilot incluido) → Bash
	"terminal.integrated.defaultProfile.linux": "Bash (login)",

	// Habilitar prompt files de GitHub Copilot
	"chat.promptFiles": true,
	"files.exclude": {
		"**/node_modules": true,
		"**/dist": true,
		"**/.cache": true,
		"**/.verify-tmp": true
	},
	"editor.formatOnSave": false,
	"js/ts.tsdk.path": "node_modules/typescript/lib",
	"js/ts.tsdk.promptToUseWorkspaceVersion": true,
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"yaml.schemas": {
		"./node_modules/@delendai/core/schema/delendai.config.schema.json": [
			"delendai.config.json"
		]
	},
	"delendai.workspace": "${workspaceFolder}",
	"delendai.configFile": "${workspaceFolder}/delendai.config.json"
}
